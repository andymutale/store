# ─── DATABASE ────────────────────────────────────────────────
# SQLite (development)
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="REPLACE_ME"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="REPLACE_ME"
# PostgreSQL (production) — uncomment and update schema.prisma provider
# DATABASE_URL="postgresql://user:password@host:5432/saintlaurens"

# ─── ADMIN AUTH ──────────────────────────────────────────────
ADMIN_USERNAME="REPLACE_ME"
# Generate with: node scripts/hashPassword.ts yourpassword
HASHED_ADMIN_PASSWORD="REPLACE_ME"

# ─── STRIPE ──────────────────────────────────────────────────
STRIPE_SECRET_KEY="REPLACE_ME"
NEXT_PUBLIC_STRIPE_PUBLIC_KEY="REPLACE_ME"
# Get from: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# In production: copy the signing secret from Stripe dashboard → Webhooks
STRIPE_WEBHOOK_SECRET="REPLACE_ME"

# ─── RESEND (email) ──────────────────────────────────────────
RESEND_API_KEY="REPLACE_ME"
# Must match a verified domain in your Resend account
# Default sender in code: orders@example.com

# ─── APP ─────────────────────────────────────────────────────
# Used in order confirmation email links
NEXT_PUBLIC_SERVER_URL="REPLACE_ME"
# Production: NEXT_PUBLIC_SERVER_URL="https://example.com"




































































